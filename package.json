{
  "name": "pos-hardware",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "dev:electron": "wait-on http://127.0.0.1:5173 && electron .",
    "dev:desktop": "npm run build:electron && concurrently \"npm run dev:web\" \"npm run dev:electron\"",
    "build": "tsc -b && vite build",
    "build:web": "tsc -b && vite build",
    "build:electron": "tsc -p tsconfig.electron.json && node -e \"require('fs').copyFileSync('electron/dist-package.json','dist-electron/package.json')\"",
    "dist": "tsc -b && vite build --base ./ && npm run build:electron && electron-builder",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "postinstall": "node -e \"const fs=require('fs');fs.copyFileSync('node_modules/sql.js/dist/sql-wasm.wasm','public/sql-wasm.wasm')\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.1",
    "date-fns": "^4.1.0",
    "fuse.js": "^7.3.0",
    "idb-keyval": "^6.2.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^6.30.3",
    "react-to-print": "^3.3.0",
    "sql.js": "^1.14.1",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "postcss": "^8.5.13",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "wait-on": "^9.0.5"
  },
  "build": {
    "appId": "com.billb.pos",
    "productName": "Bill-B POS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    }
  }
}
